# Legate Studio Configuration
# Copy to .env and fill in values

# ===== Deployment Mode =====
# single-tenant: DIY self-hosted, uses SYSTEM_PAT and allowlist (default)
# multi-tenant: SaaS mode with GitHub App, per-user isolation
LEGATO_MODE=single-tenant

# Flask secret key (auto-generated by flask_keygen.py)
FLASK_SECRET_KEY=

# Environment (development/production)
FLASK_ENV=production

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated list of allowed GitHub usernames
GITHUB_ALLOWED_USERS=bobbyhiddn

# GitHub PAT for API access (needs repo scope)
# Used for dashboard data and dispatching transcripts
SYSTEM_PAT=

# LEGATO configuration
LEGATO_ORG=bobbyhiddn
CONDUCT_REPO=Legato.Conduct

# ===== GitHub App (Multi-Tenant Auth) =====
# Create at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./your-app.private-key.pem
# The URL slug of your GitHub App (from the app URL)
GITHUB_APP_SLUG=legato-studio

# ===== Security =====

# Master encryption key for per-user data protection (REQUIRED in production)
# If not set, the key is auto-generated and stored in legato.db — insecure because
# the key and encrypted data live in the same file. Always set this in production.
# Generate with: python -m legate_studio.crypto
LEGATE_MASTER_KEY=

# JWT signing key for OAuth 2.1 token signing (separate from Flask session key)
# Falls back to FLASK_SECRET_KEY if not set, but using a separate key is recommended.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Redis URL for rate limiter storage (optional)
# Falls back to in-memory storage if not set (not safe for multi-worker deployments).
# Format: redis://[:password@]host[:port][/db-number]
# REDIS_URL=redis://localhost:6379/0

# ===== RAG/Chat Configuration =====

# OpenAI API key (for embeddings and optional chat)
OPENAI_API_KEY=

# Anthropic API key (for Claude chat)
ANTHROPIC_API_KEY=

# Google Gemini API key (for Gemini chat)
GEMINI_API_KEY=

# Chat provider: claude, openai, or gemini
CHAT_PROVIDER=claude

# Optional: specific chat model
# CHAT_MODEL=claude-sonnet-4-20250514
# CHAT_MODEL=gpt-4o-mini
# CHAT_MODEL=gemini-2.5-flash

# Optional: override the Gemini model used for voice transcription
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# Optional: Ollama host for local embeddings
# OLLAMA_HOST=http://localhost:11434

# ===== Platform backend (Vertex AI) =====
# Serve managed/platform-tier inference through Google Vertex AI instead of
# direct provider APIs. Lets you serve any Vertex-hosted model (Claude or
# Gemini) behind one GCP surface. BYOK users are unaffected — they keep using
# their own direct provider keys. Inert unless LEGATE_PLATFORM_BACKEND=vertex
# and VERTEX_PROJECT are both set.
# LEGATE_PLATFORM_BACKEND=direct        # 'direct' (default) or 'vertex'
# VERTEX_PROJECT=your-gcp-project-id     # required to enable Vertex
# VERTEX_LOCATION=us-central1            # region (Claude also accepts global/us/eu)
# VERTEX_MODEL=gemini-2.5-flash          # family inferred from prefix (claude-* or gemini-*)
# Service-account JSON, inline (mirrors GITHUB_APP_PRIVATE_KEY). Written to a
# file on the data volume at startup. Omit to use ambient GCP credentials.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ===== Tigris S3 Storage (Optional) =====
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_REGION=auto
# BUCKET_NAME=
